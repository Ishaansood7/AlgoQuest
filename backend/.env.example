# Flask Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=algoquest-hackathon-super-secret-key

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://placeholder:placeholder@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=algoquest

# AI Coach Configuration (Optional)
# If left empty, backend operates in deterministic fallback mode
AI_ENABLED=true
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-1.5-flash
AI_TIMEOUT_SECONDS=5
AI_MAX_INPUT_CHARS=1000
